requested_provider = ENV.fetch("VAGRANT_DEFAULT_PROVIDER", "virtualbox").downcase
unless requested_provider == "virtualbox"
  raise "Only the VirtualBox provider is supported."
end
ENV["VAGRANT_DEFAULT_PROVIDER"] = "virtualbox"

configuration_path = File.expand_path("../soc-detection-lab.conf", __dir__)
configuration = {}
File.foreach(configuration_path) do |line|
  match = line.match(/\A([A-Z][A-Z0-9_]*)="([^"\r\n]*)"\s*\z/)
  configuration[match[1]] = match[2] if match
end

logger_memory = Integer(configuration.fetch("LOGGER_VM_MEMORY"), 10)
dashboard_guest_port = Integer(configuration.fetch("WAZUH_DASHBOARD_GUEST_PORT"), 10)
dashboard_host_port = Integer(configuration.fetch("WAZUH_DASHBOARD_HOST_PORT"), 10)
raise "LOGGER_VM_MEMORY is outside the allowed range." unless (4096..8192).cover?(logger_memory)
raise "Invalid Wazuh dashboard port." unless (1..65_535).cover?(dashboard_guest_port) &&
                                                  (1..65_535).cover?(dashboard_host_port)
server_box_path = File.expand_path("../Boxes/windows_2016_virtualbox.box", __dir__)
win10_box_path = File.expand_path("../Boxes/windows_10_virtualbox.box", __dir__)
server_box_name = File.file?(server_box_path) ? "soc-lab/windows2016" : configuration.fetch("VAGRANT_BOX_WINDOWS")
win10_box_name = File.file?(win10_box_path) ? "soc-lab/windows10" : configuration.fetch("VAGRANT_BOX_WIN10")

Vagrant.configure("2") do |config|
  profile = ENV.fetch("SOC_PROFILE", "wazuh-core").downcase
  supported_profiles = %w[wazuh-core wazuh-ad soar-ai]
  unless supported_profiles.include?(profile)
    raise "Unsupported SOC_PROFILE '#{profile}'. Use: #{supported_profiles.join(', ')}"
  end

  include_ad = profile == "wazuh-ad"
  show_gui = ENV.fetch("SOC_GUI", "false").casecmp("true").zero?
  windows_memory = 3072
  server_memory = 2048

  config.vm.box_check_update = false

  config.vm.define "logger" do |cfg|
    cfg.vm.box = "bento/ubuntu-22.04"
    cfg.vm.hostname = "logger"
    cfg.vm.boot_timeout = 900
    cfg.ssh.username = "vagrant"
    cfg.ssh.password = "vagrant"
    cfg.ssh.insert_key = true
    cfg.ssh.keep_alive = true

    cfg.vm.synced_folder "./", "/vagrant", type: "virtualbox"
    cfg.vm.network :private_network,
                   ip: "192.168.56.105",
                   gateway: "192.168.56.1",
                   dns: "8.8.8.8"
    cfg.vm.network "forwarded_port", guest: 22, host: 5625, auto_correct: true
    cfg.vm.network "forwarded_port",
                   guest: dashboard_guest_port,
                   host: dashboard_host_port,
                   auto_correct: true

    cfg.vm.provision "file",
                     source: "../soc-detection-lab.conf",
                     destination: "/tmp/soc-detection-lab.conf"
    cfg.vm.provision :shell,
                     path: "scripts/initial-system-config.sh",
                     privileged: true,
                     keep_color: true
    cfg.vm.provision :shell,
                     path: "logger_bootstrap_enhanced.sh",
                     args: "wazuh_stack",
                     privileged: true,
                     keep_color: true,
                     env: { "SOC_PROFILE" => profile }

    cfg.vm.provider "virtualbox" do |vb|
      vb.gui = show_gui
      vb.name = "soc-lab-logger"
      vb.memory = logger_memory
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--vram", "32"]
      vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    end
  end

  if include_ad
    config.vm.define "dc" do |cfg|
      cfg.vm.box = server_box_name
      cfg.vm.box_url = server_box_path if File.file?(server_box_path)
      cfg.vm.hostname = "dc"
      cfg.vm.boot_timeout = 900
      cfg.vm.communicator = "winrm"
      cfg.winrm.transport = :plaintext
      cfg.winrm.basic_auth_only = true
      cfg.winrm.timeout = 600
      cfg.winrm.retry_limit = 20
      cfg.vm.network :private_network,
                     ip: "192.168.56.102",
                     gateway: "192.168.56.1",
                     dns: "8.8.8.8"

      cfg.vm.provision "file",
                       source: "../soc-detection-lab.conf",
                       destination: "C:/soc-detection-lab.conf"
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "reload"
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/download_palantir_wef.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-utilities.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-osquery.ps1", privileged: true
      cfg.vm.provision "shell", path: "scripts/install-sysinternals.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-wazuh-agent.ps1", privileged: true
      cfg.vm.provision "shell", path: "scripts/install-velociraptor.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-ou.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-wef-gpo.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-powershelllogging.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-AuditingPolicyGPOs.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-rdp-user-gpo.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-disable-windows-defender-gpo.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-taskbar-layout-gpo.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-autorunstowineventlog.ps1", privileged: false

      cfg.vm.provider "virtualbox" do |vb|
        vb.gui = show_gui
        vb.name = "soc-lab-dc"
        vb.memory = server_memory
        vb.cpus = 2
        vb.customize ["modifyvm", :id, "--vram", "32"]
        vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end
    end

    config.vm.define "wef" do |cfg|
      cfg.vm.box = server_box_name
      cfg.vm.box_url = server_box_path if File.file?(server_box_path)
      cfg.vm.hostname = "wef"
      cfg.vm.boot_timeout = 900
      cfg.vm.communicator = "winrm"
      cfg.winrm.basic_auth_only = true
      cfg.winrm.timeout = 600
      cfg.winrm.retry_limit = 20
      cfg.vm.network :private_network,
                     ip: "192.168.56.103",
                     gateway: "192.168.56.1",
                     dns: "192.168.56.102"

      cfg.vm.provision "file",
                       source: "../soc-detection-lab.conf",
                       destination: "C:/soc-detection-lab.conf"
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "reload"
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/download_palantir_wef.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-wefsubscriptions.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-utilities.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-osquery.ps1", privileged: true
      cfg.vm.provision "shell", path: "scripts/install-sysinternals.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-wazuh-agent.ps1", privileged: true
      cfg.vm.provision "shell", path: "scripts/install-velociraptor.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/configure-pslogstranscriptsshare.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/install-autorunstowineventlog.ps1", privileged: false
      cfg.vm.provision "evtx-samples",
                       type: "shell",
                       path: "scripts/install-evtx-attack-samples.ps1",
                       privileged: true,
                       run: "never"

      cfg.vm.provider "virtualbox" do |vb|
        vb.gui = show_gui
        vb.name = "soc-lab-wef"
        vb.memory = server_memory
        vb.cpus = 2
        vb.customize ["modifyvm", :id, "--vram", "32"]
        vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
      end
    end
  end

  config.vm.define "win10" do |cfg|
    cfg.vm.box = win10_box_name
    cfg.vm.box_url = win10_box_path if File.file?(win10_box_path)
    cfg.vm.hostname = "win10"
    cfg.vm.boot_timeout = 1200
    cfg.vm.communicator = "winrm"
    cfg.winrm.basic_auth_only = true
    cfg.winrm.timeout = 1200
    cfg.winrm.retry_limit = 20
    cfg.vm.network :private_network,
                   ip: "192.168.56.104",
                   gateway: "192.168.56.1",
                   dns: include_ad ? "192.168.56.102" : "8.8.8.8"

    cfg.vm.provision "file",
                     source: "../soc-detection-lab.conf",
                     destination: "C:/soc-detection-lab.conf"
    cfg.vm.provision "shell", path: "scripts/MakeWindows10GreatAgain.ps1", privileged: false
    if include_ad
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "reload"
      cfg.vm.provision "shell", path: "scripts/provision.ps1", privileged: false
      cfg.vm.provision "shell", path: "scripts/download_palantir_wef.ps1", privileged: false
    end
    cfg.vm.provision "shell", path: "scripts/install-utilities.ps1", privileged: false
    cfg.vm.provision "shell", path: "scripts/install-sysinternals.ps1", privileged: false
    cfg.vm.provision "shell", path: "scripts/install-velociraptor.ps1", privileged: false
    cfg.vm.provision "shell", path: "scripts/install-osquery.ps1", privileged: true
    cfg.vm.provision "shell", path: "scripts/install-wazuh-agent.ps1", privileged: true
    if include_ad
      cfg.vm.provision "shell", path: "scripts/install-autorunstowineventlog.ps1", privileged: false
    end
    cfg.vm.provision "atomic",
                     type: "shell",
                     path: "scripts/install-redteam.ps1",
                     privileged: true,
                     run: "never"

    cfg.vm.provider "virtualbox" do |vb|
      vb.gui = show_gui
      vb.name = "soc-lab-win10"
      vb.memory = windows_memory
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--vram", "32"]
      vb.customize ["modifyvm", :id, "--clipboard-mode", "bidirectional"]
      vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    end
  end
end
